@Misc{chung2026joules,
  author = {Jae-Won Chung and Ruofan Wu and Jeff J. Ma and Mosharaf Chowdhury},
  title  = {Where Do the Joules Go? Diagnosing Inference Energy Consumption},
  year   = {2026},
  note   = {arXiv:2601.22076v1. Verified against PDF title page. Measures
            inference energy via the Zeus tool (You, Chung \& Chowdhury,
            2023) across 46 models, 7 tasks, 1{,}858 configurations; finds
            output token count the dominant energy driver and batching/GPU
            utilization state a further 3--5x per-token cost swing invisible
            to the API caller. This project's own energy measurement
            (Seção~\ref{sec:green-ai-medido}) approximates the same
            quantity via direct \texttt{nvidia-smi} power-draw polling and
            trapezoidal integration, since Zeus itself was not installed in
            this project's environment -- a lighter-weight approximation of
            the same measurement goal, not a reproduction of their
            instrumentation}
}

@Misc{wang2026systematic,
  author = {Haonan Wang and Xuxin Xiao and Mingyu Yan and Zhuoyuan Zhu and
            Dengke Han and Duo Wang and Wenming Li and Xiaochun Ye and
            Cunchen Hu and Hongyang Chen and Guangyu Sun},
  title  = {A Systematic Characterization of {LLM} Inference on {GPUs}},
  year   = {2026},
  note   = {arXiv:2512.01644v1. Verified against PDF title page. Measures
            output-token count as the dominant, near-deterministic energy
            driver on instrumented A100 hardware (energy scales linearly
            with output length, $R^2=0.999$, $\approx$1.72~J/generated
            token), with input/prompt length nearly irrelevant
            ($R^2=0.071$)}
}

@Misc{vartziotis2026tokens,
  author = {Tina Vartziotis and Rodopi Kosteli and Elli Danae Vartziotis and
            George Dasoulas and Michael Keckeisen and Konstantinos Skianis
            and Sotirios Kotsopoulos and Francesca Dominici},
  title  = {From Tokens to Watt-hours: Analytical Energy Estimation for
            {LLM} Inference on Modern {GPUs}},
  year   = {2026},
  note   = {arXiv:2607.26571v1. Verified against PDF title page. Shows that
            converting token counts into absolute joules requires
            GPU-architecture-specific calibration constants fit per
            hardware generation (H100 vs.\ A100 already differ by
            $\sim$30--35\%); this project's measurement
            (Seção~\ref{sec:green-ai-medido}) sidesteps that calibration
            problem entirely by measuring power draw directly on the
            actual inference hardware via \texttt{nvidia-smi}, rather than
            estimating energy from token counts alone}
}

@Misc{tam2024speak,
  author = {Zhi Rui Tam and Cheng-Kuang Wu and Yi-Lin Tsai and Chieh-Yen Lin
            and Hung-yi Lee and Yun-Nung Chen},
  title  = {Let Me Speak Freely? A Study on the Impact of Format
            Restrictions on Performance of Large Language Models},
  year   = {2024},
  note   = {arXiv:2408.02442v1. Verified against PDF title page. Found
            forcing a model to commit to an answer key before its
            reasoning caused severe, task-specific accuracy collapse (e.g.
            86.51\%$\to$23.44\% on GSM8K), confirmed structural rather
            than a parsing artifact -- motivates constitution.md R42
            (schema field ordering: reasoning fields must precede the
            answer/verdict fields they justify)}
}

@Misc{xie2026length,
  author = {Juncheng Xie and Hung-yi Lee},
  title  = {Prompt-Based One-Shot Exact Length-Controlled Generation with
            {LLMs}},
  year   = {2026},
  note   = {arXiv:2508.13805v1. Verified against PDF title page
            (\texttt{literatura/mod\_14\_exact\_length\_control/}).
            Introduces CAPEL (Countdown-Aided Prompting for Exact Length):
            visible, sequentially-decrementing countdown markers
            interleaved with generated tokens externalize length counting,
            raising MT-Bench-LI strict length compliance with gpt-4.1 from
            below 30\% to above 95\%. Motivates constitution.md R45 and
            this project's Design D}
}

@Article{zhang2026survey,
